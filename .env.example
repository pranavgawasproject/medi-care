# MediCare — copy to frontend-next/.env.local
# Sign-in and clinical data will not work until these are set.
# Public pages (home, ESI triage, safety checker, FAQ) still render.

# Required — Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Required — anon / public key (Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical site origin (no trailing slash). Used by sitemap, robots, Open Graph.
NEXT_PUBLIC_SITE_URL=https://medicare-pranav.vercel.app

# Optional — Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Legacy names still accepted as a compatibility shim (do not use in new deploys)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Never expose the service-role key to the Next.js app.
# SUPABASE_SERVICE_ROLE_KEY is not used by this codebase.
